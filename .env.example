# Copy to .env.local and fill in your values.
# The .env.local file is gitignored — never commit real credentials.

# SMTP server for outgoing email (support tickets + public order/quote requests).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-app-specific-password
SUPPORT_TO=support@yourdomain.com
QUOTES_TO=orders@yourdomain.com
SUPPORT_FROM=you@yourdomain.com

# REQUIRED in production. Long random value. Derives the key that encrypts
# per-admin SMTP passwords stored in content/users.json. If you change it,
# existing encrypted SMTP passwords must be re-entered in the admin panel.
ADMIN_SECRET=generate-a-long-random-value

# REQUIRED in production. Protects the /api/admin/overdue/auto cron endpoint.
# Call it with header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-long-random-value

